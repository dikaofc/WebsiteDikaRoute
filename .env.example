# ===== Email pengirim (SMTP Gmail) =====
# Gunakan APP PASSWORD Gmail (16 karakter), bukan password akun biasa.
# Buat di: https://myaccount.google.com/apppasswords (wajib 2FA aktif)
MAIL_USER="email.pengirim@gmail.com"
MAIL_PASS="16-karakter-app-password"

# ===== Opsional: token untuk broadcast rilis (POST /api/newsletter/broadcast) =====
# Jika dikosongkan, token acak akan dicetak di console saat server boot.
# BROADCAST_TOKEN="rahasia-saya"

# ===== Playground =====
# Set ke 1 bila backend gateway AI sudah terhubung (playground aktif).
# Default: kosong → halaman menampilkan "PLAYGROUND IS NOT AVAILABLE RIGHT NOW".
# PLAYGROUND_ENABLED=1

# ===== Donasi Saweria QRIS (pembayaran nyata) =====
# Username akun Saweria penerima donasi (di belakang saweria.co/...).
SAWERIA_USERNAME="dikatech"
# Mode tes tanpa menyentuh Saweria: 1 = buat kode QR palsu (transaksi berakhiran :paid dianggap lunas).
# SAWERIA_MOCK=1
# Matikan pembayaran Saweria sepenuhnya (POST /api/donation/pay → 503).
# SAWERIA_DISABLED=1
# Masa berlaku kode QRIS (default 3 menit).
# PAYMENT_TTL_MS=180000

# ===== Webhook Saweria (real-time tanpa polling) =====
# 1) Buat secret acak, misal: openssl rand -hex 24
# 2) Di dashboard Saweria → Integrations → Webhook → isi:
#    URL: https://<domain-kamu>/api/webhooks/saweria/<secret>  (method POST)
# 3) Saat donasi dibayar, Saweria POST ke URL tsb → status langsung 'paid'
#    (dipush real-time ke halaman donasi via SSE, tanpa polling klien).
# Wajib diisi agar webhook aktif; jika kosong, endpoint selalu 404.
# SAWERIA_WEBHOOK_SECRET="ganti-dengan-secret-acak"
