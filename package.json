{
  "name": "dikaroute-website",
  "private": true,
  "version": "1.0.0",
  "description": "Official website for DikaRoute — Unified AI Gateway & Intelligent Model Router",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "node scripts/e2e-test.mjs",
    "broadcast": "node scripts/send-release.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.475.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
